# --- Postgres ---
POSTGRES_USER=sales_agent
POSTGRES_PASSWORD=sales_agent
POSTGRES_DB=sales_agent
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend / Auth ---
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# First admin user, auto-created on first backend startup
FIRST_ADMIN_EMAIL=admin@shiveshwartextiles.com
FIRST_ADMIN_PASSWORD=change-me-immediately

# --- Frontend ---
VITE_API_BASE_URL=/api/v1

# --- M5 Outreach Delivery Engine ---
# No default (unlike SECRET_KEY above) - the app fails loudly the first
# time credential code runs without this set, rather than silently using
# a known key. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Register an OAuth client in Google Cloud Console (Gmail API, scope
# gmail.send) and an app registration in Azure/Entra (Microsoft Graph,
# scope Mail.Send + offline_access) to fill these in. Delivery simply
# won't offer that provider as connectable until its client id/secret are
# set - nothing else breaks.
#
# Both redirect URIs point at the FRONTEND (not the backend) - see
# app/delivery/connection_service.py's docstring. Register this exact
# URL in both Google Cloud Console and the Azure app registration; using
# the same URL for both providers is fine, each validates independently
# against its own client_id.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback

MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT_ID=common
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback

# --- M7.2 AI Execution Platform (AI Gateway) ---
# No defaults, deliberately - each ProviderClient's own is_configured()
# checks the relevant key before ever attempting a real call (see
# app/ai_gateway/providers/*.py), so leaving all of these blank does not
# break anything that doesn't actually need a real model call - it just
# means that feature stays on its non-AI fallback (see
# RESEARCH_ANALYSIS_ENGINE_BACKEND below for the concrete example).
#
# Only ANTHROPIC_API_KEY / ANTHROPIC_DEFAULT_MODEL are required for the
# M2 Phase 3 Research Intelligence Engine specifically - there is no
# dedicated routing entry for it in app/ai_gateway/router.py's
# ROUTING_POLICY, so it falls through to ROUTING_POLICY["default"],
# which points at provider_key "claude" only. OPENAI_*/GOOGLE_* are not
# used by anything in this codebase yet - listed here only because
# app/core/config.py already defines them, for whenever a future feature
# routes to one of those providers.
ANTHROPIC_API_KEY=
# Model IDs are not hardcoded anywhere in this codebase (provider model
# catalogs change too often for a code-level default to stay
# trustworthy) - set the exact model id you want to use here (check
# Anthropic's current model list for the exact string). Required: if
# this is unset and no per-call model override exists,
# app/ai_gateway/providers/claude_client.py raises InvalidRequestError
# rather than guessing.
ANTHROPIC_DEFAULT_MODEL=
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=
GOOGLE_API_KEY=
GOOGLE_DEFAULT_MODEL=

# --- M2 Phase 3: Research Intelligence Engine ---
# Which AIAnalysisEngine app/research/pipeline.py uses, selected via
# app/research/analysis/registry.py - "deterministic" (default,
# keyword/regex matching, no AI Gateway calls, no API key needed) or
# "llm" (real analysis via ResearchAnalysisAgent, the first concrete
# Agent this codebase has shipped - requires ANTHROPIC_API_KEY and
# ANTHROPIC_DEFAULT_MODEL above to be set, or every research run will
# degrade to empty/low-confidence results instead of raising).
RESEARCH_ANALYSIS_ENGINE_BACKEND=deterministic

# --- M9: AI Provider Hierarchy (Local -> Free -> Premium) ---------------
# See docs/architecture/ai-provider-hierarchy-v3-plan.md for the full
# design. AI_MODE selects which provider tiers are auto-attempted vs.
# gated behind explicit user approval - one of: local_only,
# hybrid_recommended (default), automatic_premium, premium_only.
AI_MODE=hybrid_recommended

# Whether AIGateway.complete() actually enforces the "stop and ask before
# premium" gate. True by default (M9 ships alongside the Research page's
# own approval dialog) - set to false to auto-attempt a premium provider
# whenever it's the only configured option (byte-for-byte the pre-M9
# behavior).
AI_GATEWAY_REQUIRE_PREMIUM_APPROVAL=true

# Local inference (Ollama, vLLM, LM Studio, or anything speaking the same
# OpenAI-compatible wire protocol) - unset by default, no local provider
# attempted until configured. Most local servers need no API key.
LOCAL_MODEL_BASE_URL=
LOCAL_MODEL_API_KEY=
LOCAL_MODEL_DEFAULT_MODEL=

# Groq (free-tier cloud, OpenAI-compatible API) - unset by default.
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1
